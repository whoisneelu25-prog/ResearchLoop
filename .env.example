# -----------------------------------------------------------------------------
# ResearchLoop Environment Configuration Example
# Copy this file to .env and fill in required values where appropriate
# -----------------------------------------------------------------------------

# Database Configuration (Defaults to local SQLite if unset)
DATABASE_URL=sqlite:///./researchloop.db
# For PostgreSQL:
# DATABASE_URL=postgresql://researchloop:researchloop_password@localhost:5432/researchloop

# JWT Secret for User Authentication
JWT_SECRET=researchloop-super-secret-key-change-in-production-2026

# Optional: Neo4j Graph Database (Defaults to internal Relational Graph if unset)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=researchloop_password

# Optional: LLM Configuration (Defaults to Scientific NLP Rule-based Fallback if unset)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Optional: Biomedical Data Provider API Keys
PUBMED_API_KEY=

# Frontend API URL
VITE_API_URL=http://localhost:8000
